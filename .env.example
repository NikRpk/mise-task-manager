# App URL (used for OAuth redirects and cron/link generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Client-side, public)
# Get these from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase (Server-side, secret — bypasses Row Level Security)
# Get this from Supabase Dashboard > Project Settings > API > service_role key
# NEVER expose this to the client / commit it to git.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Used by `npm run supabase:types` to generate types/supabase.ts
SUPABASE_PROJECT_ID="your-project-ref"

# Google OAuth (for "Sign in with Google" AND Google Calendar integration)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Slack Integration
# Bot token with chat:write and users:read.email scopes
SLACK_BOT_TOKEN="xoxb-your-bot-token"
# Slack Workflow Builder webhook URL for user-submitted feedback
SLACK_FEEDBACK_WEBHOOK_URL="https://hooks.slack.com/triggers/your-webhook-url"

# Feedback Slack channel (shown in the feedback modal)
NEXT_PUBLIC_SLACK_CHANNEL_NAME="your-feedback-channel"
NEXT_PUBLIC_SLACK_CHANNEL_URL="https://your-slack-workspace.slack.com/channels/your-feedback-channel"

# Secret shared with Vercel Cron so /api/cron/* routes can verify the request.
# Vercel automatically sends this as `Authorization: Bearer $CRON_SECRET` for
# crons defined in vercel.json — just set the same value here and in Vercel.
CRON_SECRET="generate-a-long-random-string"
